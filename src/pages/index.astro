---
import {
  BadgeCheck,
  Blocks,
  Cable,
  Globe,
  Handshake,
  Mail,
  Menu,
  MessagesSquare,
  PanelsTopLeft,
  Scale,
  Workflow,
  Wrench,
  X,
} from "@lucide/astro";
import "../styles/global.css";

const rotatingWords = ["accessibile", "chiaro", "aperto", "sicuro", "sostenibile", "su misura"];
const pixelColumns = 30;
const pixelRows = 12;
const markOrigin = { col: 12, row: 3 };
const isLitPixel = (index: number) => {
  const row = Math.floor(index / pixelColumns) - markOrigin.row;
  const col = (index % pixelColumns) - markOrigin.col;

  return (
    (row === 0 && col >= 0 && col <= 3) ||
    (row >= 1 && row <= 3 && col >= 0 && col <= 1) ||
    (row >= 1 && row <= 3 && col === 4) ||
    (row === 4 && col >= 0 && col <= 3)
  );
};

const services = [
  {
    icon: Globe,
    title: "Siti web",
    text: "Siti chiari, veloci e manutenibili per presentare il progetto e metterlo online senza dipendenze inutili.",
  },
  {
    icon: PanelsTopLeft,
    title: "Applicazioni interne",
    text: "Strumenti su misura per ordinare processi, dati e attività che oggi dipendono da fogli di calcolo o soluzioni improvvisate.",
  },
  {
    icon: Workflow,
    title: "Automazioni",
    text: "Flussi che riducono il lavoro ripetitivo e collegano gli strumenti che il team usa già ogni giorno.",
  },
  {
    icon: Cable,
    title: "Integrazioni",
    text: "Connessioni tra servizi, API e sistemi esistenti per ridurre passaggi manuali, attese ed errori.",
  },
  {
    icon: Wrench,
    title: "Manutenzione ed evoluzione",
    text: "Evoluzione tecnica con criterio: aggiornamenti, correzioni e miglioramenti senza trasformarli in un costo opaco.",
  },
  {
    icon: MessagesSquare,
    title: "Consulenza tecnica",
    text: "Affiancamento per prendere decisioni tecniche, scegliere strumenti ed evitare blocchi con fornitori o piattaforme.",
  },
];

const values = [
  {
    icon: Scale,
    title: "Trasparenza",
    text: "Preventivi comprensibili, priorità chiare e decisioni tecniche spiegate prima di costruire.",
  },
  {
    icon: Blocks,
    title: "Software libero",
    text: "Preferiamo strumenti aperti quando sono adatti. Il codice può essere consegnato al cliente e, quando l'accordo lo permette, pubblicato per la comunità.",
  },
  {
    icon: Handshake,
    title: "Collaborazione diretta",
    text: "Dialogo con chi costruisce la soluzione, senza livelli commerciali che complicano il progetto.",
  },
  {
    icon: BadgeCheck,
    title: "Qualità sostenibile",
    text: "Preferiamo soluzioni piccole, solide ed evolutive rispetto a grandi promesse difficili da mantenere.",
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Debugga - Soluzioni tecnologiche accessibili</title>
    <meta
      name="description"
      content="Debugga crea siti web, applicazioni interne, automazioni, integrazioni e consulenza tecnica con software accessibile, aperto e sostenibile."
    />
    <meta name="theme-color" content="#e4151b" />
    <link rel="canonical" href="https://debugga.it/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/svg/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/png/icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content="https://debugga.it/" />
    <meta property="og:site_name" content="Debugga" />
    <meta property="og:title" content="Debugga - Soluzioni tecnologiche accessibili" />
    <meta
      property="og:description"
      content="Soluzioni software vicine, aperte e progettate per restare sostenibili."
    />
    <meta property="og:image" content="https://debugga.it/brand/png/logo-1280.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Debugga - Soluzioni tecnologiche accessibili" />
    <meta
      name="twitter:description"
      content="Soluzioni software vicine, aperte e progettate per restare sostenibili."
    />
    <meta name="twitter:image" content="https://debugga.it/brand/png/logo-1280.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="Debugga">
        <img src="/brand/svg/logo.svg" alt="Debugga, Soluzioni tecnologiche" width="1158" height="217" />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Apri menu">
        <Menu class="nav-icon-open" size={24} strokeWidth={2.2} aria-hidden="true" />
        <X class="nav-icon-close" size={24} strokeWidth={2.2} aria-hidden="true" />
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Navigazione principale">
        <a href="#servizi">Cosa facciamo</a>
        <a href="#valori">Valori</a>
        <a href="#contatti">Contatti</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="pixel-field" style={`--pixel-cols: ${pixelColumns}`} aria-hidden="true">
          {Array.from({ length: pixelColumns * pixelRows }).map((_, index) => (
            <span class:list={{ lit: isLitPixel(index) }} />
          ))}
        </div>
        <div class="hero-copy">
          <h1 id="hero-title">
            <span class="hero-title-static">Il software su misura può essere</span>
            <span class="rotating-word" data-words={JSON.stringify(rotatingWords)}>accessibile</span>
          </h1>
          <p class="hero-text">
            Realizziamo progetti come vorremmo riceverli noi: con trasparenza, qualità e attenzione alla manutenzione.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#contatti">
              <Mail size={20} strokeWidth={2.1} aria-hidden="true" />
              Contattaci
            </a>
            <a class="button secondary" href="mailto:info@debugga.it">
              <MessagesSquare size={20} strokeWidth={2.1} aria-hidden="true" />
              info@debugga.it
            </a>
          </div>
        </div>
      </section>

      <section id="servizi" class="section services-section" aria-labelledby="services-title">
        <div class="section-heading">
          <h2 id="services-title">Software utile, costruito sulla dimensione reale del progetto.</h2>
        </div>
        <div class="service-grid">
          {services.map((service) => {
            const Icon = service.icon;

            return (
            <article class="service-card">
              <div class="service-head">
                <div class="service-icon" aria-hidden="true">
                  <Icon size={25} strokeWidth={2.1} />
                </div>
                <h3>{service.title}</h3>
              </div>
              <p>{service.text}</p>
            </article>
            );
          })}
        </div>
      </section>

      <section class="section work-section" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Prima capire, poi costruire.</h2>
        </div>
        <div class="work-layout">
          <p class="lead">
            Prima di proporre tecnologia, capiamo quale problema va risolto, quale parte ha più impatto e come
            mantenerla senza far crescere i costi senza controllo.
          </p>
          <ol class="work-steps">
            <li>
              <span>01</span>
              <strong>Definiamo l'ambito</strong>
              Disegniamo una prima versione utile, con priorità e budget comprensibili.
            </li>
            <li>
              <span>02</span>
              <strong>Costruiamo con visibilità</strong>
              Condividiamo avanzamenti, decisioni e limiti mentre il progetto prende forma.
            </li>
            <li>
              <span>03</span>
              <strong>Lasciamo spazio all'evoluzione</strong>
              Documentiamo, consegniamo l'accesso al codice quando serve e pensiamo alla manutenzione fin dall'inizio.
            </li>
          </ol>
        </div>
      </section>

      <section id="valori" class="section values-section" aria-labelledby="values-title">
        <div class="section-heading">
          <h2 id="values-title">Tecnologia aperta, chiara e responsabile.</h2>
        </div>
        <div class="value-grid">
          {values.map((value) => {
            const Icon = value.icon;

            return (
            <article class="value-card">
              <h3>
                <Icon size={22} strokeWidth={2.1} aria-hidden="true" />
                {value.title}
              </h3>
              <p>{value.text}</p>
            </article>
            );
          })}
        </div>
      </section>

      <!--
      <section class="section proof-section" aria-labelledby="proof-title">
        <div>
          <h2 id="proof-title">Abbiamo lavorato su siti, strumenti interni e applicazioni SaaS.</h2>
        </div>
        <p>
          Alcuni progetti sono soluzioni su misura per clienti specifici; altri esplorano strade che possono diventare
          software libero. Preferiamo raccontare ogni caso al momento giusto e con il contesto completo.
        </p>
      </section>
      -->

      <section id="contatti" class="section contact-section" aria-labelledby="contact-title">
        <div class="contact-copy">
          <h2 id="contact-title">Parliamone.</h2>
          <p>
            Hai un'idea o un problema che richiede software? <br/> Scrivici e lo valutiamo con calma.
          </p>
        </div>
        <div class="contact-grid" aria-label="Canali di contatto">
          <a class="contact-card" href="mailto:info@debugga.it?subject=Nuovo%20progetto" aria-label="Scrivere a Debugga per un nuovo progetto">
            <span class="contact-icon" aria-hidden="true">
              <MessagesSquare size={34} strokeWidth={2.1} />
            </span>
            <span class="contact-user">Nuovo progetto</span>
          </a>
          <a class="contact-card contact-card-main" href="mailto:info@debugga.it" aria-label="Inviare una email a info@debugga.it">
            <span class="contact-icon" aria-hidden="true">
              <Mail size={34} strokeWidth={2.1} />
            </span>
            <span class="contact-user">info@debugga.it</span>
          </a>
          <a class="contact-card" href="mailto:info@debugga.it?subject=Consulenza%20tecnica" aria-label="Scrivere a Debugga per una consulenza tecnica">
            <span class="contact-icon" aria-hidden="true">
              <Handshake size={34} strokeWidth={2.1} />
            </span>
            <span class="contact-user">Consulenza</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Debugga - Soluzioni tecnologiche</span>
      <a href="mailto:info@debugga.it">info@debugga.it</a>
    </footer>

    <script>
      const wordEl = document.querySelector(".rotating-word");
      const motionSafe = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
      const navToggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");

      if (wordEl && motionSafe) {
        const words = JSON.parse(wordEl.dataset.words || "[]");
        let index = 0;

        window.setInterval(() => {
          index = (index + 1) % words.length;
          wordEl.classList.add("is-changing");

          window.setTimeout(() => {
            wordEl.textContent = words[index];
            wordEl.classList.remove("is-changing");
          }, 180);
        }, 2200);
      }

      if (navToggle && nav) {
        const closeNav = () => {
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Apri menu");
          nav.classList.remove("is-open");
        };

        navToggle.addEventListener("click", () => {
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";

          navToggle.setAttribute("aria-expanded", String(!isOpen));
          navToggle.setAttribute("aria-label", isOpen ? "Apri menu" : "Chiudi menu");
          nav.classList.toggle("is-open", !isOpen);
        });

        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeNav);
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeNav();
          }
        });
      }
    </script>
  </body>
</html>
