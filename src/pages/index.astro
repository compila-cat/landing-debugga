---
import {
  BadgeCheck,
  Blocks,
  Cable,
  Globe,
  Handshake,
  Mail,
  Menu,
  MessagesSquare,
  PanelsTopLeft,
  Scale,
  Workflow,
  Wrench,
  X,
} from "@lucide/astro";
import "../styles/global.css";

const rotatingWords = ["assequible", "proper", "obert", "just", "segur", "sostenible"];
const pixelColumns = 30;
const pixelRows = 12;
const cOrigin = { col: 11, row: 2 };
const isLitPixel = (index: number) => {
  const row = Math.floor(index / pixelColumns) - cOrigin.row;
  const col = (index % pixelColumns) - cOrigin.col;

  return (
    (row === 0 && col >= 2 && col <= 7) ||
    (row === 1 && col >= 1 && col <= 2) ||
    (row >= 2 && row <= 5 && col >= 0 && col <= 1) ||
    (row === 6 && col >= 1 && col <= 2) ||
    (row === 7 && col >= 2 && col <= 7)
  );
};

const services = [
  {
    icon: Globe,
    title: "Pàgines web",
    text: "Webs clares, ràpides i mantenibles per explicar el projecte i posar-lo en marxa sense dependència innecessària.",
  },
  {
    icon: PanelsTopLeft,
    title: "Aplicatius interns",
    text: "Eines a mida per ordenar processos, dades i tasques que avui depenen de fulls de càlcul o solucions improvisades.",
  },
  {
    icon: Workflow,
    title: "Automatitzacions",
    text: "Fluxos que estalvien feina repetitiva i connecten les eines que ja feu servir.",
  },
  {
    icon: Cable,
    title: "Integracions",
    text: "Connexions entre serveis, APIs i sistemes existents per reduir passos manuals i errors.",
  },
  {
    icon: Wrench,
    title: "Manteniment i evolució",
    text: "Evolució tècnica amb criteri: actualitzacions, correccions i millores sense convertir-ho en una quota opaca.",
  },
  {
    icon: MessagesSquare,
    title: "Consultoria tècnica",
    text: "Acompanyament per prendre decisions tècniques, triar eines i evitar bloquejos amb proveïdors o plataformes.",
  },
];

const values = [
  {
    icon: Scale,
    title: "Transparència",
    text: "Pressupostos entenedors, prioritats clares i decisions tècniques explicades abans de construir.",
  },
  {
    icon: Blocks,
    title: "Programari lliure",
    text: "Prioritzem eines obertes quan encaixen. El codi que fem es pot entregar al client i, si l'acord ho permet, publicar per a la comunitat.",
  },
  {
    icon: Handshake,
    title: "Proximitat",
    text: "Tracte directe amb qui construeix la solució, sense capes comercials que compliquin el projecte.",
  },
  {
    icon: BadgeCheck,
    title: "Qualitat sostenible",
    text: "Preferim solucions petites, sòlides i evolutives abans que grans promeses difícils de mantenir.",
  },
];
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Compila - Programari a mida assequible</title>
    <meta
      name="description"
      content="Compila crea pàgines web, aplicatius interns, automatitzacions, integracions i consultoria amb programari assequible, obert i proper."
    />
    <meta name="theme-color" content="#e4151b" />
    <link rel="canonical" href="https://compila.cat/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/svg/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/png/icon-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:url" content="https://compila.cat/" />
    <meta property="og:site_name" content="Compila" />
    <meta property="og:title" content="Compila - Programari a mida assequible" />
    <meta
      property="og:description"
      content="Solucions de software properes, obertes i pensades per ser sostenibles."
    />
    <meta property="og:image" content="https://compila.cat/brand/png/logo-1280.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Compila - Programari a mida assequible" />
    <meta
      name="twitter:description"
      content="Solucions de software properes, obertes i pensades per ser sostenibles."
    />
    <meta name="twitter:image" content="https://compila.cat/brand/png/logo-1280.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="Compila">
        <img src="/brand/svg/logo.svg" alt="Compila, Solucions Tecnològiques" width="1110" height="188" />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Obrir menú">
        <Menu class="nav-icon-open" size={24} strokeWidth={2.2} aria-hidden="true" />
        <X class="nav-icon-close" size={24} strokeWidth={2.2} aria-hidden="true" />
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Navegació principal">
        <a href="#serveis">Què fem</a>
        <a href="#valors">Valors</a>
        <a href="#contacte">Contacte</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="pixel-field" style={`--pixel-cols: ${pixelColumns}`} aria-hidden="true">
          {Array.from({ length: pixelColumns * pixelRows }).map((_, index) => (
            <span class:list={{ lit: isLitPixel(index) }} />
          ))}
        </div>
        <div class="hero-copy">
          <h1 id="hero-title">
            <span class="hero-title-static">El programari a mida pot ser</span>
            <span class="rotating-word" data-words={JSON.stringify(rotatingWords)}>assequible</span>
          </h1>
          <p class="hero-text">
            Duem a terme projectes com a nosaltres ens agradaria que ens els portéssin: amb transparència, qualitat, i seguretat.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#contacte">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                <path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7" />
              </svg>
              Contacta amb nosaltres
            </a>
            <a class="button secondary" href="https://github.com/compila-cat" rel="noreferrer" target="_blank">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              Visita'ns a GitHub
            </a>
          </div>
        </div>
      </section>

      <section id="serveis" class="section services-section" aria-labelledby="services-title">
        <div class="section-heading">
          <h2 id="services-title">Programari útil, fet a la mida real del projecte.</h2>
        </div>
        <div class="service-grid">
          {services.map((service) => {
            const Icon = service.icon;

            return (
            <article class="service-card">
              <div class="service-head">
                <div class="service-icon" aria-hidden="true">
                  <Icon size={25} strokeWidth={2.1} />
                </div>
                <h3>{service.title}</h3>
              </div>
              <p>{service.text}</p>
            </article>
            );
          })}
        </div>
      </section>

      <section class="section work-section" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Primer entendre, després construir.</h2>
        </div>
        <div class="work-layout">
          <p class="lead">
            Abans de proposar tecnologia, mirem quin problema cal resoldre, quina part té més impacte i com
            es pot mantenir sense que el cost creixi sense control.
          </p>
          <ol class="work-steps">
            <li>
              <span>01</span>
              <strong>Concretem l'abast</strong>
              Definim una primera versió útil, amb prioritats i pressupost entenedor.
            </li>
            <li>
              <span>02</span>
              <strong>Construïm amb visibilitat</strong>
              Compartim avenços, decisions i limitacions mentre el projecte pren forma.
            </li>
            <li>
              <span>03</span>
              <strong>Deixem marge per evolucionar</strong>
              Documentem, entreguem accés al codi quan toca i pensem en el manteniment des del principi.
            </li>
          </ol>
        </div>
      </section>

      <section id="valors" class="section values-section" aria-labelledby="values-title">
        <div class="section-heading">
          <h2 id="values-title">Tecnologia oberta, clara i amb responsabilitat.</h2>
        </div>
        <div class="value-grid">
          {values.map((value) => {
            const Icon = value.icon;

            return (
            <article class="value-card">
              <h3>
                <Icon size={22} strokeWidth={2.1} aria-hidden="true" />
                {value.title}
              </h3>
              <p>{value.text}</p>
            </article>
            );
          })}
        </div>
      </section>

      <!--
      <section class="section proof-section" aria-labelledby="proof-title">
        <div>
          <h2 id="proof-title">Hem treballat en webs, eines internes i aplicatius tipus SaaS.</h2>
        </div>
        <p>
          Alguns projectes són solucions a mida per clients concrets; altres exploren camins que poden acabar
          sent programari lliure. Preferim explicar cada cas quan toca i amb el context complet.
        </p>
      </section>
      -->

      <section id="contacte" class="section contact-section" aria-labelledby="contact-title">
        <div class="contact-copy">
          <h2 id="contact-title">Contacta amb nosaltres</h2>
          <p>
            Tens una idea o un problema que demana programari? <br/> Escriu-nos i en parlem amb calma.
          </p>
        </div>
        <div class="contact-grid" aria-label="Canals de contacte">
          <a class="contact-card" href="https://github.com/compila-cat" rel="noreferrer" target="_blank" aria-label="GitHub de Compila">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </span>
            <span class="contact-user">compila-cat</span>
          </a>
          <a class="contact-card contact-card-main" href="mailto:info@compila.cat" aria-label="Enviar correu a info@compila.cat">
            <span class="contact-icon" aria-hidden="true">
              <Mail size={34} strokeWidth={2.1} />
            </span>
            <span class="contact-user">info@compila.cat</span>
          </a>
          <a class="contact-card" href="https://www.linkedin.com/company/compila-cat/" rel="noreferrer" target="_blank" aria-label="LinkedIn de Compila">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
                <path d="M2 9h4v12H2z" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            </span>
            <span class="contact-user">Compila</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Compila, Solucions Tecnològiques SL</span>
      <a href="mailto:info@compila.cat">info@compila.cat</a>
    </footer>

    <script>
      const wordEl = document.querySelector(".rotating-word");
      const motionSafe = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
      const navToggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");

      if (wordEl && motionSafe) {
        const words = JSON.parse(wordEl.dataset.words || "[]");
        let index = 0;

        window.setInterval(() => {
          index = (index + 1) % words.length;
          wordEl.classList.add("is-changing");

          window.setTimeout(() => {
            wordEl.textContent = words[index];
            wordEl.classList.remove("is-changing");
          }, 180);
        }, 2200);
      }

      if (navToggle && nav) {
        const closeNav = () => {
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Obrir menú");
          nav.classList.remove("is-open");
        };

        navToggle.addEventListener("click", () => {
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";

          navToggle.setAttribute("aria-expanded", String(!isOpen));
          navToggle.setAttribute("aria-label", isOpen ? "Obrir menú" : "Tancar menú");
          nav.classList.toggle("is-open", !isOpen);
        });

        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeNav);
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeNav();
          }
        });
      }
    </script>
  </body>
</html>
